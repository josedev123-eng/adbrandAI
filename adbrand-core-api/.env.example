# Copiar este archivo como .env y completar los valores. El .env no se sube al repositorio.

# Contraseña del usuario "postgres" de tu PostgreSQL local (base "adbrand").
DB_PASSWORD=

# Firma de los tokens de sesión. Usa una frase larga y propia.
JWT_SECRET=
# Horas que dura el token de sesión.
JWT_HORAS=8
# Días que dura el token de renovación de la app móvil (HU 43).
JWT_RENOVACION_DIAS=30

# Servidor de IA de Tecsup (solo funciona dentro de la red del instituto).
# Con AI_MOCK=true se devuelven textos de prueba y no hace falta lo demás.
AI_MOCK=true
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_CHAT_PATH=/api/chat/completions
AI_TIMEOUT_SECONDS=60

# Correos (HU 24 y 28). Con MAIL_MOCK=true se escriben en la consola y no se envían.
MAIL_MOCK=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@adbrand.ai
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

# Notificaciones push (HU 49, 50 y 52). Sin FIREBASE_ENABLED=true se escribe en la consola.
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
NOTIFICACIONES_CRON=0 0 9 * * *
NOTIFICACIONES_SUSCRIPCIONES_CRON=0 30 9 * * *
NOTIFICACIONES_ZONA=America/Lima

# IA de imágenes. Con AI_IMAGE_MOCK=true las imágenes son de prueba (no se gasta nada).
AI_IMAGE_MOCK=true
# Cloudflare Workers AI (gratis, borradores): dash.cloudflare.com > AI > Workers AI > REST API
CF_ACCOUNT_ID=
CF_API_TOKEN=
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# OpenRouter (prepago, versión final y retoques): openrouter.ai/settings/keys (ponle un límite de crédito)
AI_IMAGE_API_KEY=
# AI_IMAGE_MODEL=google/gemini-2.5-flash-image
# Retoques de pago por empresa al mes (control de gasto). Por defecto 20.
# AI_IMAGE_RETOUCH_LIMIT=20
