# Copiar este archivo como .env y completar los valores. El .env no se sube al repositorio.

# Contraseña del usuario "postgres" de tu PostgreSQL local (base "adbrand").
DB_PASSWORD=

# Firma de los tokens de sesión. Usa una frase larga y propia.
JWT_SECRET=
# Horas que dura el token de sesión.
JWT_HORAS=8
# Días que dura el token de renovación de la app móvil (HU 43).
JWT_RENOVACION_DIAS=30

# Servidor de IA de Tecsup (solo funciona dentro de la red del instituto).
# Con AI_MOCK=true se devuelven textos de prueba y no hace falta lo demás.
AI_MOCK=true
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_CHAT_PATH=/api/chat/completions
AI_TIMEOUT_SECONDS=60

# Correos (HU 24 y 28). Con MAIL_MOCK=true se escriben en la consola y no se envían.
MAIL_MOCK=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@adbrand.ai
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
