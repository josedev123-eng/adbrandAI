# Copiar este archivo como .env y completar los valores. El .env no se sube al repositorio.

# Contraseña del usuario "postgres" de tu PostgreSQL local (la misma base "adbrand" que usa Spring Boot).
DB_PASSWORD=

# Dirección de Spring Boot, para revisar el estado del servidor (HU 18).
CORE_API_URL=http://localhost:8080

# Correos del panel (código para recuperar la contraseña, avisos de moderación y suspensión).
# Sin MAIL_HOST se escriben en la consola de Django y no se envían. Para Gmail ver adbrand-docs/correo-gmail.md.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-responder@adbrand.ai
