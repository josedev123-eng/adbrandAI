# Copiar este archivo como .env y completar los valores. El .env no se sube al repositorio.

# Contraseña del usuario "postgres" de tu PostgreSQL local (la misma base "adbrand" que usa Spring Boot).
DB_PASSWORD=

# Dirección de Spring Boot, para revisar el estado del servidor (HU 18).
CORE_API_URL=http://localhost:8080
